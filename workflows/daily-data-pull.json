    },
    {
      "name": "Flatten buyers",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        780,
        120
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const nm = v => (v && typeof v === 'object') ? (v.name ?? '') : (v ?? '');\nreturn $input.all().flatMap(page => (page.json.buyers || []).map(b => { const c = (b.contacts || []).find(x => x.email) || (b.contacts || [])[0] || {};\n  return { json: { buyer_id: b.id, name: b.name ?? '', city: b.city ?? '', stage: nm(b.stage),\n    receiving_days: [b.receiving_start_day, b.receiving_end_day].filter(Boolean).join(' to '),\n    contact_name: [c.name, c.last_name].filter(Boolean).join(' '), total_orders: b.total_orders ?? '', on_hold: b.hold ? 'yes' : 'no' } }; }));"
      }
    },
