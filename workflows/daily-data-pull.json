{
  "name": "Daily wholesale data pull (sample)",
  "nodes": [
    {
      "name": "Every day 4:30am",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.4,
      "position": [
        0,
        0
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "daysInterval": 1,
              "field": "days",
              "triggerAtHour": 4,
              "triggerAtMinute": 30
            }
          ]
        }
      }
    },
    {
      "name": "Weekdays 9am, noon, 3pm",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.4,
      "position": [
        0,
        160
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 9,12,15 * * 1-5"
            }
          ]
        }
      }
    },
    {
      "name": "Last 3 days",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        240,
        80
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const from = new Date(Date.now() - 3*24*60*60*1000).toISOString().slice(0,19) + 'Z';\nreturn [{ json: { updated_at_from: from } }];"
      }
    },
    {
      "name": "Platform: shipping orders",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [
        520,
        -200
      ],
      "parameters": {
        "method": "GET",
        "url": "https://app.apextrading.com/api/v1/shipping-orders",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpBearerAuth",
        "sendQuery": true,
        "specifyQuery": "keypair",
        "queryParameters": {
          "parameters": [
            {
              "name": "updated_at_from",
              "value": "={{ $json.updated_at_from }}"
            },
            {
              "name": "with_items",
              "value": "true"
            },
            {
              "name": "per_page",
              "value": "100"
            }
          ]
        },
        "sendHeaders": true,
        "specifyHeaders": "keypair",
        "headerParameters": {
          "parameters": [
            {
              "name": "Accept",
              "value": "application/json"
            }
          ]
        },
        "options": {
          "pagination": {
            "pagination": {
              "paginationMode": "responseContainsNextURL",
              "nextURL": "={{ $response.body.links.next }}",
              "paginationCompleteWhen": "other",
              "completeExpression": "={{ !$response.body.links || !$response.body.links.next }}",
              "limitPagesFetched": true,
              "maxRequests": 300,
              "requestInterval": 250
            }
          }
        }
      },
      "executeOnce": true,
      "credentials": {
        "httpBearerAuth": {
          "id": "SET_YOUR_OWN",
          "name": "Wholesale platform API (read only)"
        }
      }
    },
    {
      "name": "Flatten order lines",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        780,
        -200
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const num = v => { const n = parseFloat(String(v ?? '').replace(/[^0-9.\\-]/g, '')); return isNaN(n) ? '' : n; };\nconst nm = v => (v && typeof v === 'object') ? (v.name ?? '') : (v ?? '');\nconst rows = [];\nfor (const page of $input.all()) for (const o of (page.json.orders || [])) for (const it of (o.items || [])) {\n  const qty = num(it.order_quantity) || 0, price = num(it.order_price) || 0;\n  rows.push({ json: { line_key: `${o.id}-${it.id}`, order_id: o.id, invoice_number: o.invoice_number ?? '',\n    order_date: (o.order_date || '').slice(0, 10), delivery_date: (o.delivery_date || '').slice(0, 10), status: nm(o.order_status),\n    payment_status: o.payment_status ?? '', buyer_id: o.buyer_id ?? '', buyer_name: nm(o.buyer) || o.ship_name || '',\n    product_name: it.product_name ?? '', category: nm(it.product_category), quantity: qty, unit: nm(it.order_unit_measurement),\n    unit_price: price, line_total: Math.round(qty * price * 100) / 100 } });\n}\nreturn rows;"
      }
    },
    {
      "name": "Sheet: Orders",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.7,
      "position": [
        1040,
        -200
      ],
      "parameters": {
        "resource": "sheet",
        "operation": "appendOrUpdate",
        "documentId": {
          "__rl": true,
          "mode": "id",
          "value": "YOUR_GOOGLE_SHEET_ID"
        },
        "sheetName": {
          "__rl": true,
          "mode": "name",
          "value": "Orders"
        },
        "columns": {
          "mappingMode": "autoMapInputData",
          "value": {},
          "matchingColumns": [
            "line_key"
          ],
          "schema": []
        },
        "options": {
          "handlingExtraData": "ignoreIt"
        }
      },
      "credentials": {
        "googleSheetsOAuth2Api": {
          "id": "SET_YOUR_OWN",
          "name": "Google Sheets account"
        }
      }
    },
    {
      "name": "Platform: buyers",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [
        520,
        120
      ],
      "parameters": {
        "method": "GET",
        "url": "https://app.apextrading.com/api/v1/buyers",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpBearerAuth",
        "sendQuery": true,
        "specifyQuery": "keypair",
        "queryParameters": {
