    {
      "name": "Flatten inventory",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1040,
        440
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const nm = v => (v && typeof v === 'object') ? (v.name ?? '') : (v ?? '');\nconst today = new Date().toISOString().slice(0, 10);\n// THC and THCA as entered on the batch's lab results. Blank if not entered; never estimated.\nconst cann = (b, ab) => { const c = (b?.cannabinoids || []).find(x => String(x.abbreviation || '').toUpperCase() === ab); const v = c ? parseFloat(c.measurement) : NaN; return isNaN(v) ? '' : Math.round(v * 10) / 10; };\nconst rows = [];\nfor (const page of $('Platform: available inventory').all()) {\n  for (const p of (page.json.available_inventory || [])) {\n    const batches = (p.batches && p.batches.length) ? p.batches : [null];\n    for (const b of batches) {\n      const terps = (b?.terpenes || []).slice().sort((x, y) => (parseFloat(y.measurement) || 0) - (parseFloat(x.measurement) || 0))\n        .slice(0, 3).map(t => `${t.display_name || t.name} ${t.measurement ?? ''}`.trim()).join(', ');\n      rows.push({ json: {\n        snapshot_date: today, product_id: p.id, product_name: p.name ?? '', category: nm(p.category), cultivar: nm(p.cultivar),\n        product_available_qty: p.available_qty ?? '', unit: nm(p.unit_measurement), batch_id: b?.id ?? '', batch_qty: b?.quantity ?? '',\n        potency_tac: b?.predominate_cannabinoid_min_or_only ?? '', thc: cann(b, 'THC'), thca: cann(b, 'THCA'), top_terpenes: terps,\n        on_hold: b ? (b.hold ? 'yes' : 'no') : '', allow_samples: b ? (b.allow_samples ? 'yes' : 'no') : '',\n      }});\n    }\n  }\n}\nreturn rows;"
      }
    },
