{
  "name": "Cultivation Desk Bot",
  "nodes": [
    {
      "name": "Desk Run Request",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2.2,
      "position": [
        0,
        96
      ],
      "parameters": {
        "httpMethod": "POST",
        "path": "SET_YOUR_OWN_RANDOM_PATH",
        "responseMode": "lastNode",
        "responseData": "firstEntryJson"
      }
    },
    {
      "name": "Send or Read",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3.2,
      "position": [
        224,
        96
      ],
      "parameters": {
        "rules": {
          "values": [
            {
              "conditions": {
                "combinator": "and",
                "conditions": [
                  {
                    "leftValue": "={{ $json.body.action }}",
                    "operator": {
                      "operation": "equals",
                      "type": "string"
                    },
                    "rightValue": "send"
                  }
                ],
                "options": {
                  "caseSensitive": true,
                  "leftValue": "",
                  "typeValidation": "strict"
                }
              },
              "outputKey": "send"
            },
            {
              "conditions": {
                "combinator": "and",
                "conditions": [
                  {
                    "leftValue": "={{ $json.body.action }}",
                    "operator": {
                      "operation": "equals",
                      "type": "string"
                    },
                    "rightValue": "read"
                  }
                ],
                "options": {
                  "caseSensitive": true,
                  "leftValue": "",
                  "typeValidation": "strict"
                }
              },
              "outputKey": "read"
            },
            {
              "conditions": {
                "combinator": "and",
                "conditions": [
                  {
                    "leftValue": "={{ $json.body.action }}",
                    "operator": {
                      "operation": "equals",
                      "type": "string"
                    },
                    "rightValue": "history"
                  }
                ],
                "options": {
                  "caseSensitive": true,
                  "leftValue": "",
                  "typeValidation": "strict"
                }
              },
              "outputKey": "history"
            }
          ]
        }
      }
    },
    {
      "name": "Send DM as Bot",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [
        448,
        0
      ],
      "parameters": {
        "method": "POST",
        "url": "https://slack.com/api/chat.postMessage",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "slackApi",
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify(Object.assign({ channel: $json.body.user, text: $json.body.text, unfurl_links: false }, $json.body.thread_ts ? { thread_ts: $json.body.thread_ts } : {})) }}"
      },
      "credentials": {
        "slackApi": {
          "id": "SET_YOUR_OWN",
          "name": "Your Slack bot token"
        }
      }
    },
    {
      "name": "Read Thread Replies",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [
        448,
        192
      ],
      "parameters": {
        "method": "GET",
        "url": "https://slack.com/api/conversations.replies",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "slackApi",
        "sendQuery": true,
        "specifyQuery": "keypair",
        "queryParameters": {
          "parameters": [
            {
              "name": "channel",
              "value": "={{ $json.body.channel }}"
            },
            {
              "name": "ts",
              "value": "={{ $json.body.ts }}"
            },
            {
              "name": "limit",
              "value": "200"
            }
          ]
        }
      },
      "credentials": {
        "slackApi": {
          "id": "SET_YOUR_OWN",
          "name": "Your Slack bot token"
        }
      }
    },
    {
      "name": "Read DM After Post",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [
        448,
        384
      ],
      "parameters": {
        "method": "GET",
        "url": "https://slack.com/api/conversations.history",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "slackApi",
        "sendQuery": true,
        "specifyQuery": "keypair",
        "queryParameters": {
          "parameters": [
            {
              "name": "channel",
              "value": "={{ $json.body.channel }}"
            },
            {
              "name": "oldest",
              "value": "={{ $json.body.ts }}"
            },
            {
              "name": "limit",
              "value": "200"
            }
          ]
        }
      },
      "credentials": {
        "slackApi": {
          "id": "SET_YOUR_OWN",
          "name": "Your Slack bot token"
        }
      }
    }
  ],
  "connections": {
    "Desk Run Request": {
      "main": [
        [
          {
            "node": "Send or Read",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Send or Read": {
      "main": [
        [
          {
            "node": "Send DM as Bot",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Read Thread Replies",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Read DM After Post",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  }
}